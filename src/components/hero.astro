---
import { Image } from "astro:assets";
// import HeroImage from "../assets/ramsey.jpg";
import HeroImage from "../assets/ramsey-portrait.jpg";
---

<section class={"hero"} id="hero">
  <div class={"hero__content"}>
    <h1 class={"titles"}>Hey, I’m Ramsey</h1>
    <p>
      I’m an early-career software developer with a strong interest in frontend development. I build
      <span class="highlight">full-stack websites</span> across frontend and backend, with a focus on
      useful, thoughtful experiences.
    </p>
    <div class="hero__buttons">
      <a class={"btn"} href="#projects">View My Work</a>
    </div>
  </div>
  <div class={"hero__image"}>
    <Image src={HeroImage} alt="Ramsey Ediku" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 6fr 3.25fr;
    gap: var(--space-6);
    margin-block: var(--space-9) var(--space-12);

    .hero__content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      margin-right: var(--space-4);
      h1 {
        font-size: 3.75rem;
      }

      p {
        font-weight: 300;
        margin: 0;
      }
    }

    .hero__image {
      display: flex;
      justify-content: flex-end;
      img {
        --dimension: 17.5rem;
        width: var(--dimension);
        height: var(--dimension);
        border-radius: 50%;
        box-shadow: var(--box-shadow);
        &:focus,
        &:hover {
          cursor: pointer;
        }
        /* filter: brightness(1.01) contrast(1.05) saturate(1.03) sepia(0.01); */
      }
    }
  }

  .hero__buttons {
    display: flex;
    gap: var(--space-4);
  }
</style>

<script defer>
  let heroImage = document.querySelector(".hero__image > img");
  heroImage?.addEventListener("click", () => {
    heroImage.style.transform = "scale(1.1)";
  });
</script>
