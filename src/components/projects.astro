---
import { Image } from "astro:assets";
import archery from "../assets/archery-thumbnail.png";
import jamchat from "../assets/jamchat-thumbnail.png";
import link from "../assets/link.svg";
import info from "../assets/info.svg";
import github from "../assets/github.svg";

const projectFiles = await Astro.glob("../markdown/projects/projects.md");
const rawProjects = projectFiles[0]?.frontmatter?.projects ?? [];
const projects = rawProjects.map((project: any) => ({
  ...project,
  img: project.slug === "archery" ? archery : project.slug === "jamchat" ? jamchat : archery,
}));
---

<hr />
<section class="projects" id="projects">
  <div class="projects__header">
    <h2 class="titles">Projects</h2>
    <p>
      A few <span class="highlight">web projects </span>that showcase how I work and what I can
      build.
    </p>
  </div>

  <div class="projects__grid">
    {
      projects.map((project: any) => (
        <article class="project__card">
          <Image class={"project__thumbnail"} src={project.img} alt={project.title} />
          <h3>{project.title}</h3>

          <section class="project__info">
            <p>{project.desc}</p>
            <div class="project__links">
              {project.github !== "" ? (
                <a
                  class={"link-pop link-pop-inverse"}
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Image src={github} alt="link to repo" />
                </a>
              ) : (
                <span />
              )}

              <a
                class={"link-pop link-pop-inverse"}
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Image src={link} alt="" />
              </a>
              <a class={"link-pop link-pop-inverse"} href={project.page}>
                <Image src={info} alt="link to info page" />
              </a>
            </div>
          </section>
        </article>
      ))
    }
  </div>
</section>
<style>
  .projects {
    margin-block: var(--space-10) calc(var(--space-10) + 4.125rem);

    .projects__header {
      margin-bottom: var(--space-8);
    }

    .projects__grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));

      .project__card {
        cursor: pointer;
        border-radius: var(--border-radius);
        padding: var(--space-10);
        background: hsl(from var(--clr-brand-secondary) h s l);
        box-shadow: var(--box-shadow);
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease;

        & > img {
          object-fit: cover;
          border-radius: calc(var(--border-radius) * 1.5);
          width: 100%;
          max-height: 300px;
          aspect-ratio: 1/1;
          box-shadow:
            rgba(50, 50, 93, 0.25) 0px 6px 12px -2px,
            rgba(0, 0, 0, 0.3) 0px 3px 7px -3px;
        }

        h3 {
          color: var(--clr-brand);
          font-family: sans-serif;
          font-weight: 900;
          font-size: var(--space-8);
          margin-top: var(--space-6);
          font-family: "Inter Variable", sans-serif;
        }
        .project__info {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-top: var(--space-12);

          p {
            text-transform: uppercase;
            letter-spacing: 0.085em;
            font-size: 1.15rem;
            margin: 0;
            color: rgb(from var(--clr-brand) r g b / 0.75);
          }

          .project__links {
            display: flex;
            gap: var(--space-5);

            img {
              --dimension: var(--space-8);
              width: var(--dimension);
              height: var(--dimension);
            }
          }
        }
      }
    }
  }
</style>
