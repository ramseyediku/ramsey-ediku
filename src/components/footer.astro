---
const { currentYear = new Date(Date.now()).getFullYear() } = Astro.props;
import { Image } from "astro:assets";
import linkedinIcon from "../assets/linkedin.svg";
import emailIcon from "../assets/email.svg";
import formIcon from "../assets/form.svg";
import closeIcon from "../assets/close.svg";
---

<hr />
<footer class="footer" id="contact">
  <h2 class="titles">Let’s build together</h2>
  <p class="footer__description">
    If you want to start a project, collaborate on an idea, or just say hello, my inbox is open.
    Reach me out using the button below.
  </p>
  <div class="contact-wrap">
    <button id="contactBtn" class={"btn footer__button"} aria-haspopup="true" aria-expanded="false"
      >Contact Me</button
    >

    <div
      id="contactPopover"
      class="contact-popover"
      role="dialog"
      aria-label="Contact links"
      data-open="false"
    >
      <ul>
        <li>
          <a href="https://www.linkedin.com/in/ramseyediku" target="_blank"
            ><Image src={linkedinIcon} alt="LinkedIn" class="popover-icon" />LinkedIn</a
          >
        </li>
        <li>
          <a href="mailto:hello@ramseyediku.com"
            ><Image src={emailIcon} alt="Email" class="popover-icon" />Email</a
          >
        </li>
        <li>
          <a id="openFormLink" href=""
            ><Image src={formIcon} alt="Contact form" class="popover-icon" />Form</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>

<!-- Contact form modal -->
<div id="contactModal" class="contact-modal" aria-hidden="true">
  <div class="contact-modal__backdrop" data-open="false"></div>
  <div class="contact-modal__panel" role="dialog" aria-modal="true" aria-label="Contact form">
    <header class="contact-modal__header">
      <h3 class="titles">Contact Me</h3>
      <button id="modalClose" aria-label="Close contact form">
        <Image src={closeIcon} alt="close icon for form modal" />
      </button>
    </header>

    <form
      action="https://formsubmit.co/ramseyediku@protonmail.com"
      method="POST"
      id="contactForm"
      class="contact-form"
    >
      <label>
        <span>Name</span>
        <input name="name" type="text" required />
      </label>

      <label>
        <span>Email</span>
        <input name="email" type="email" required />
      </label>

      <label>
        <span>Message</span>
        <textarea name="message" rows="4" required></textarea>
      </label>

      <div class="contact-form__actions">
        <button type="submit" class="btn">Send</button>
      </div>
    </form>
  </div>
</div>

<div class="footer__bottom">
  <div class="footer__bottom__links">
    <a href="#hero">Home</a>
    <a href="#about">About</a>
    <a href="#projects">Projects</a>
    <a href="/resume">Resume</a>
  </div>
  <p>©{currentYear} Ramsey Ediku. All rights reserved.</p>
</div>

<style>
  .footer {
    margin-top: var(--space-12);

    .btn {
      margin-block: var(--space-12) 0;
    }
  }

  .contact-wrap {
    position: relative;
    display: inline-block;
    margin-block: var(--space-7);
    width: 20%;

    .footer__button {
      width: 100%;
    }
  }

  .contact-popover {
    position: absolute;
    left: 115%;
    top: -25%;
    transform: scale(0.5);
    background-color: var(--clr-dark);
    color: var(--clr-light);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    min-width: 12rem;
    opacity: 0;
    pointer-events: none;
    transform-origin: center center;
    box-shadow: var(--box-shadow);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.2, 1, 0.22, 1);
    z-index: 40;

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      color: var(--clr-light);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: var(--space-5) var(--space-6);
      border-radius: var(--border-radius);
      transition:
        background-color 160ms ease,
        color 160ms ease;

      .popover-icon {
        --dimension: 1.4rem;
        width: var(--dimension);
        height: var(--dimension);
        object-fit: contain;
        filter: invert(90%) sepia(12%) saturate(475%) hue-rotate(316deg) brightness(105%)
          contrast(113%);
        transition:
          filter 160ms ease,
          transform 160ms ease;
      }

      &:hover {
        background-color: var(--clr-light);
        color: var(--clr-dark);
        outline: none;

        .popover-icon {
          filter: none;
        }
      }
    }

    li:nth-of-type(1) a {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    li:nth-of-type(2) a {
      border-radius: 0;
      border-top: 1px solid rgb(from var(--clr-grey) r g b / 0.35);
    }
    li:nth-of-type(3) a {
      border-top-left-radius: 0;
      border-top-right-radius: 0;
      border-top: 1px solid rgb(from var(--clr-grey) r g b / 0.35);
    }
  }

  .contact-popover[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  /* Contact modal */
  .contact-modal {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 60;
  }

  .contact-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .contact-modal[data-open="true"] .contact-modal__backdrop,
  .contact-modal__backdrop[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .contact-modal__panel {
    position: relative;
    width: min(600px, calc(100% - var(--space-6)));
    background: var(--clr-brand-bg);
    color: var(--clr-dark);
    border-radius: var(--border-radius);
    padding: var(--space-6);
    box-shadow: var(--box-shadow);
    transform: translateY(10px) scale(0.98);
    opacity: 0;
    transform: scale(0);
    pointer-events: auto;
    transition:
      transform 220ms cubic-bezier(0.2, 1, 0.22, 1),
      opacity 160ms ease;
    outline: 4px solid rgb(from var(--clr-brand-secondary) r g b / 0.5);
  }

  .contact-modal[aria-hidden="false"] .contact-modal__panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .contact-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);

    h3 {
      margin: 0;
      font-size: 2rem;
    }

    button {
      background-color: transparent;
      border: 0;
      img {
        --dimension: 2rem;
        z-index: 5;
        width: var(--dimension);
        height: var(--dimension);
      }
    }
  }

  .contact-form label {
    display: block;
    margin-block: var(--space-6) var(--space-3);
  }
  .contact-form span {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: var(--space-4) var(--space-3);
    border-radius: calc(var(--border-radius) / 2);
    border: 0;
    background-color: var(--clr-light);
    outline: 3px solid rgb(from var(--clr-brand-secondary) r g b / 0.5);
  }

  .contact-form__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-block: var(--space-12) var(--space-6);
    color: var(--clr-grey);
    font-size: 0.96rem;

    .footer__bottom__links {
      display: flex;
      gap: var(--space-6);

      a {
        color: var(--clr-brand);

        &:hover,
        &:focus-within {
          text-decoration: underline;
        }
      }
    }
  }
</style>

<script type="module" is:inline>
  const btn = document.getElementById("contactBtn");
  const pop = document.getElementById("contactPopover");

  if (btn && pop) {
    const setOpen = (isOpen) => {
      pop.setAttribute("data-open", isOpen ? "true" : "false");
      btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      if (isOpen) {
        const first = pop.querySelector("a");
        if (first) setTimeout(() => first.focus(), 80);
      }
    };

    btn.addEventListener("click", () => {
      const isOpen = pop.getAttribute("data-open") === "true";
      setOpen(!isOpen);
    });

    document.addEventListener("click", (e) => {
      if (!pop.contains(e.target) && !btn.contains(e.target)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  // Modal behavior
  const openFormLink = document.getElementById("openFormLink");
  const modal = document.getElementById("contactModal");
  const modalClose = document.getElementById("modalClose");
  const modalCancel = document.getElementById("modalCancel");
  const modalBackdrop = modal?.querySelector(".contact-modal__backdrop");
  const contactForm = document.getElementById("contactForm");

  const openModal = () => {
    if (!modal) return;
    modal.setAttribute("aria-hidden", "false");
    modal.querySelector(".contact-modal__backdrop").setAttribute("data-open", "true");
    // move focus
    const firstInput = modal.querySelector("input, textarea, button");
    if (firstInput) setTimeout(() => firstInput.focus(), 80);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.setAttribute("aria-hidden", "true");
    modal.querySelector(".contact-modal__backdrop").setAttribute("data-open", "false");
    // return focus to contact button
    if (btn) btn.focus();
  };

  if (openFormLink && modal) {
    openFormLink.addEventListener("click", (e) => {
      e.preventDefault();
      // close popover first
      pop.setAttribute("data-open", "false");
      openModal();
    });

    modalClose?.addEventListener("click", () => closeModal());
    modalCancel?.addEventListener("click", () => closeModal());

    modalBackdrop?.addEventListener("click", () => closeModal());

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  }
</script>
