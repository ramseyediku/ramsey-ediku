---

<footer class="footer" id="contact">
  <div class="footer__content">
    <div class="footer__brand">
      <h2 class="titles">Let’s build together</h2>
      <p class="footer__description">
        Whether you want to start a new project, collaborate on a creative idea, or just say hello,
        my inbox is open.
      </p>
    </div>

    <div class="footer__details">
      <div class="footer__item">
        <h3>Contact</h3>
        <p>Email: <a href="mailto:hello@example.com">hello@example.com</a></p>
        <p>Phone: <a href="tel:+1234567890">+1 (234) 567-890</a></p>
      </div>

      <div class="footer__item">
        <h3>Quick links</h3>
        <ul>
          <li><a href="#services">Services</a></li>
          <li><a href="#work">Work</a></li>
          <li><a href="#about">About</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <p>© 2026 Ramsey Ediku. Crafted for clarity, speed, and thoughtful digital experiences.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-12);
    padding: 4rem 2rem;
    background: var(--clr-accent-2);
    color: var(--clr-light);
    border-top-left-radius: var(--border-radius);
    border-top-right-radius: var(--border-radius);
  }

  .footer__content {
    display: grid;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .footer__brand {
    max-width: 40rem;
  }

  .footer__description {
    margin: 1.25rem 0 0;
    max-width: 36rem;
  }

  .footer__details {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .footer__item h3 {
    margin: 0 0 1rem;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #f9fafb;
  }

  .footer__item p,
  .footer__item li {
    margin: 0.4rem 0;
    color: #cbd5e1;
    font-size: 0.95rem;
  }

  .footer__item ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer__item a {
    color: var(--clr-light);
    text-decoration: none;
  }

  .footer__bottom {
    margin-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    text-align: center;
    color: #9ca3af;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .footer__details {
      grid-template-columns: 1fr;
    }
  }
</style>
