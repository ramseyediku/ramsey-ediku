---
const { title } = Astro.props;
// Supports weights 100-900
import "@fontsource-variable/inter/wght.css";
import "@fontsource/rammetto-one";
import "../styles/reset.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <title>{title}</title>
  </head>
  <body data-barba="wrapper">
    <slot />
  </body>
</html>

<script>
  import barba from "@barba/core";
  import { gsap } from "gsap";

  // barba.init({
  //   transitions: [
  //     {
  //       name: "opacity-transition",
  //       leave(data: any) {
  //         return gsap.to(data.current.container, {
  //           opacity: 0,
  //         });
  //       },
  //       enter(data: any) {
  //         return gsap.from(data.next.container, {
  //           opacity: 0,
  //         });
  //       },
  //     },
  //   ],
  // });
</script>

<style is:global>
  /* Global styles */
  :root {
    /* colors */
    --clr-brand: hsl(30, 28%, 18%);
    --clr-brand-secondary: hsl(35, 50%, 73%);
    --clr-brand-bg: hsl(36, 100%, 96%);
    --clr-brand-bg: hsl(36, 100%, 96%);

    --clr-light: hsl(34, 100%, 99%);

    --clr-dark: hsl(0, 0%, 8%);
    --clr-grey: hsl(218, 11%, 65%);

    /* spacing */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-7: 1.75rem;
    --space-8: 2rem;
    --space-9: 2.25rem;
    --space-10: 2.5rem;
    --space-11: 2.75rem;
    --space-12: 3rem;

    --border-radius: 1rem;

    --box-shadow:
      rgb(from var(--clr-brand) r g b / 0.25) 0px 3px 12px -2px,
      rgb(from var(--clr-brand) r g b / 0.3) 0px 1px 7px -3px;
  }

  .container {
    width: min(calc(97.5% - var(--space-8)), 1200px);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  body {
    background-color: var(--clr-brand-bg);
    color: var(--clr-dark);
    font-size: 1.155rem;

    &::selection {
      background-color: var(--clr-brand-secondary);
    }
  }

  .titles {
    margin: 0;
    letter-spacing: -0.0185em;
    font-weight: 800;
    color: var(--clr-brand);
    margin: 0;
  }

  /* Utility heading sizes (apply the `titles` class to h1, h2, h3 elements)
     Use project-consistent sizes here so heading styles are centralized. */
  h1.titles {
    font-size: 3.75rem;
  }
  h2.titles {
    font-size: 3.35rem;
  }
  h3.titles {
    font-size: var(--space-8);
  }

  .highlight {
    background-color: var(--clr-brand-secondary);
    border-radius: calc(var(--border-radius) / 2);
    padding: 0.1rem var(--space-1);
  }

  /* h1/h2/h3 sizing moved to utility classes above */

  hr {
    background-color: rgb(from var(--clr-brand-secondary) r g b / 0.5);
    width: var(--space-12);
    height: 7.5px;
    aspect-ratio: 2/1;
    border: 0;
    margin: 0 auto;
    border-radius: calc(var(--border-radius) / 3);
  }

  .btn {
    font-family: "Inter Variable", sans-serif;
    display: inline-block;
    border: 0;
    padding: var(--space-3) var(--space-7);
    background-color: var(--clr-dark);
    color: var(--clr-light);
    text-decoration: none;
    transition: background-color 300ms ease-in-out;
    background-color: var(--clr-brand);
    border-radius: calc(var(--border-radius) / 2);
    box-shadow: var(--box-shadow);

    &:hover {
      background-color: var(--clr-brand);
    }
  }

  .btn--secondary {
    background-color: var(--clr-brand);
    color: var(--clr-dark);
    outline: 1px solid var(--clr-brand);

    &:hover {
      background-color: var(--clr-brand);
      color: var(--clr-light);
    }
  }

  .link-pop {
    position: relative;
    isolation: isolate;
    z-index: 2;
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: calc(var(--border-radius) * 0.8);
      background-color: var(--clr-brand-secondary);
      scale: 0;
      transition: scale 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: -1;
    }

    &:hover,
    &:focus-within {
      font-weight: 700;

      &::before {
        background-color: var(--clr-brand-secondary);
        scale: 1.25;
        transition: scale 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
      }
    }
  }

  .link-pop-inverse {
    &:hover,
    &:focus-within {
      img {
        filter: invert(80%) sepia(9%) saturate(1270%) hue-rotate(348deg) brightness(107%)
          contrast(73%);
      }
    }

    &::before,
    &:hover::before,
    &:focus-within::before {
      background-color: var(--clr-brand);
    }

    &:hover::before,
    &:focus-within::before {
      scale: 1.4;
    }
  }

  .project-page {
    border: solid 1px red;
    margin-top: var(--space-9);
  }
</style>
